EVALUATE
VAR _derniere = TOPN(1, vent_solaire_horaire, vent_solaire_horaire[heure], DESC)
VAR _kpDerniere = MAX(kp_3h[debut_tranche])
RETURN
ROW(
    "heure", MAXX(_derniere, vent_solaire_horaire[heure]),
    "vitesse", MAXX(_derniere, vent_solaire_horaire[vitesse_moy_kms]),
    "densite", MAXX(_derniere, vent_solaire_horaire[densite_moy_cm3]),
    "bz", MAXX(_derniere, vent_solaire_horaire[bz_min_nt]),
    "pression", MAXX(_derniere, vent_solaire_horaire[pression_max_npa]),
    "newell", MAXX(_derniere, vent_solaire_horaire[couplage_newell_moy]),
    "kp", CALCULATE(MAX(kp_3h[kp]), kp_3h[debut_tranche] = _kpDerniere),
    "kpTranche", _kpDerniere,
    "kpMax24h", CALCULATE(MAX(kp_3h[kp]), kp_3h[debut_tranche] > _kpDerniere - 1),
    "vitesseMax24h", MAXX(FILTER(vent_solaire_horaire, vent_solaire_horaire[heure] > MAXX(_derniere, vent_solaire_horaire[heure]) - 1), vent_solaire_horaire[vitesse_max_kms]),
    "bzMin24h", MINX(FILTER(vent_solaire_horaire, vent_solaire_horaire[heure] > MAXX(_derniere, vent_solaire_horaire[heure]) - 1), vent_solaire_horaire[bz_min_nt])
)
